  ['sun', 92, 4, 0.9, 10, 'gold'],
  ['wave-mini', 88, 8, 0.65, -8, 'lime'],
  ['confetti', 96, 10, 0.7, 18, 'pink'],
  ['asterisk', 7, 14, 0.72, 12, 'lime'],
  ['squiggle', 17, 17, 0.62, -12, 'gold'],
  ['bubbles', 26, 15, 0.7, 0, 'pink'],
  ['spark', 41, 16, 0.7, 14, 'gold'],
  ['seed', 57, 14, 0.6, -20, 'lime'],
  ['heart', 68, 16, 0.58, 10, 'pink'],
  ['cross', 84, 18, 0.58, -14, 'gold'],
  ['dash', 97, 20, 0.65, -24, 'lime'],
  ['spray', 2, 28, 0.8, 24, 'gold'],
  ['mini-leaf', 14, 27, 0.7, -18, 'lime'],
  ['dot', 23, 30, 0.46, 0, 'pink'],
  ['ring', 34, 30, 0.58, 0, 'gold'],
  ['sparkle', 46, 28, 0.62, -10, 'lime'],
  ['squiggle', 61, 31, 0.58, 18, 'pink'],
  ['bubbles', 76, 29, 0.72, 12, 'gold'],
  ['asterisk', 91, 30, 0.78, -12, 'lime'],
  ['confetti', 98, 32, 0.75, 8, 'pink'],
  ['wave-mini', 4, 42, 0.72, -16, 'lime'],
  ['dash', 15, 40, 0.58, 20, 'gold'],
  ['drop', 27, 43, 0.55, -8, 'pink'],
  ['sun', 39, 42, 0.62, 6, 'gold'],
  ['spark', 52, 41, 0.62, -14, 'pink'],
  ['seed', 67, 43, 0.56, 20, 'lime'],
  ['cross', 82, 42, 0.58, 16, 'pink'],
  ['ring', 94, 41, 0.52, 0, 'gold'],
  ['mini-star', 7, 55, 0.68, -16, 'gold'],
  ['bubbles', 18, 54, 0.62, 0, 'lime'],
  ['confetti', 30, 56, 0.7, 14, 'pink'],
  ['sparkle', 45, 54, 0.58, 8, 'gold'],
  ['wave-mini', 58, 55, 0.64, -10, 'lime'],
  ['heart', 72, 56, 0.52, -18, 'pink'],
  ['dash', 86, 54, 0.6, 22, 'gold'],
  ['squiggle', 97, 57, 0.58, -12, 'lime'],
  ['asterisk', 3, 68, 0.75, 8, 'pink'],
  ['mini-leaf', 13, 70, 0.64, 20, 'lime'],
  ['dot', 25, 67, 0.45, 0, 'gold'],
  ['ring', 38, 70, 0.6, 0, 'lime'],
  ['spark', 51, 68, 0.66, -20, 'pink'],
  ['spray', 63, 70, 0.7, 18, 'gold'],
  ['wave-mini', 74, 69, 0.74, -6, 'lime'],
  ['cross', 89, 69, 0.54, 12, 'pink'],
  ['sun', 97, 70, 0.58, -6, 'gold'],
  ['bubbles', 6, 83, 0.7, 0, 'lime'],
  ['dash', 16, 82, 0.6, -20, 'gold'],
