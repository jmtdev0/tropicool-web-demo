    address: {
      '@type': 'PostalAddress',
      streetAddress: 'C/ Oslo 53, C.C. X Madrid',
      addressLocality: 'Alcorcón',
      addressRegion: 'Madrid',
      postalCode: '28922',
      addressCountry: 'ES',
    },
  },
};

const menuDoodles = [
  ['/images/assets/menu/doodles/tropical-drink.png', 3, 2, 1, -12],
  ['/images/assets/menu/doodles/palm-leaf.png', 75, 1, 0.9, 17],
  ['/images/assets/menu/doodles/monstera.png', 50, 8, 0.78, -7],
  ['/images/assets/menu/doodles/flamingo.png', 8, 22, 0.78, 9],
  ['/images/assets/menu/doodles/pineapple.png', 82, 28, 0.82, -10],
  ['/images/assets/menu/doodles/surfboard.png', 1, 45, 0.72, -13],
  ['/images/assets/menu/doodles/sunglasses.png', 68, 48, 0.7, 13],
  ['/images/assets/menu/doodles/wave.png', 29, 57, 0.72, 8],
  ['/images/assets/menu/doodles/tropical-sun.png', 5, 73, 0.7, 14],
  ['/images/assets/menu/doodles/nachos.png', 73, 74, 0.76, -11],
  ['/images/assets/menu/doodles/burger.png', 43, 3, 0.52, -31],
  ['/images/assets/menu/doodles/taquitos.png', 31, 19, 0.58, 16],
  ['/images/assets/menu/doodles/palm-leaf.png', 88, 58, 0.55, -18],
  ['/images/assets/menu/doodles/tropical-drink.png', 14, 91, 0.6, -9],
  ['/images/assets/menu/doodles/monstera.png', 47, 88, 0.64, 12],
  ['/images/assets/menu/doodles/flamingo.png', 63, 18, 0.5, -6],
  ['/images/assets/menu/doodles/pineapple.png', 18, 39, 0.52, 8],
  ['/images/assets/menu/doodles/surfboard.png', 56, 36, 0.5, 20],
  ['/images/assets/menu/doodles/wave.png', 84, 90, 0.58, -10],
].map(([src, x, y, s, r]) => ({ src, x, y, s, r }));

const mainDoodleClearanceZones = menuDoodles.map((doodle) => ({
  cx: doodle.x + 8 * doodle.s,
  cy: doodle.y + 8 * doodle.s,
  rx: 5.5 * doodle.s + 2.4,
  ry: 9 * doodle.s + 2.8,
}));

const menuContentClearanceZones = [];

const isAwayFromMainDoodles = ([, x, y, s]) => {
  const cx = x + s;
  const cy = y + s;

  const avoidsMainDoodles = mainDoodleClearanceZones.every((zone) => (
    Math.abs(cx - zone.cx) > zone.rx + s * 2 || Math.abs(cy - zone.cy) > zone.ry + s * 2
  ));
  const avoidsContent = menuContentClearanceZones.every((zone) => (
    cx < zone.x1 || cx > zone.x2 || cy < zone.y1 || cy > zone.y2
  ));

  return avoidsMainDoodles && avoidsContent;
};

const isAwayFromOtherSprinkles = (sprinkle, selectedSprinkles) => {
  const [, x, y, s] = sprinkle;
  const cx = x + s;
  const cy = y + s;

  return selectedSprinkles.every((selected) => {
    const [, selectedX, selectedY, selectedS] = selected;
    const selectedCx = selectedX + selectedS;
    const selectedCy = selectedY + selectedS;
    const distance = Math.hypot(cx - selectedCx, (cy - selectedCy) * 0.72);

    return distance > 2.9 + (s + selectedS) * 1.15;
  });
};

const handPlacedMenuSprinkles = [
  ['sparkle', 4, 4, 1.05, -8, 'gold'],
  ['ring', 10, 2, 0.55, 12, 'lime'],
