  ['sparkle', 39, 84, 0.64, -12, 'lime'],
  ['ring', 51, 82, 0.54, 0, 'gold'],
  ['mini-star', 63, 84, 0.62, 8, 'pink'],
  ['estela', 76, 83, 0.68, -18, 'lime'],
  ['seed', 87, 85, 0.52, 18, 'gold'],
  ['dot', 96, 83, 0.48, 0, 'pink'],
  ['confetti', 9, 94, 0.68, -10, 'gold'],
  ['wave-mini', 24, 93, 0.7, 8, 'lime'],
  ['asterisk', 42, 94, 0.6, 0, 'gold'],
  ['bubbles', 57, 92, 0.58, 0, 'pink'],
  ['mini-leaf', 71, 94, 0.62, -20, 'lime'],
  ['spark', 83, 93, 0.58, 12, 'gold'],
  ['ring', 95, 94, 0.58, 0, 'pink'],
];

const sprinkleTypes = [
  'sparkle',
  'ring',
  'mini-star',
  'dot',
  'dash',
  'wave-mini',
  'confetti',
  'asterisk',
  'squiggle',
  'bubbles',
  'spark',
  'seed',
  'cross',
  'spray',
  'mini-leaf',
  'drop',
  'estela',
];

const sprinkleTones = ['gold', 'lime', 'pink'];

const seededNoise = (index, salt) => {
  const value = Math.sin((index + 1) * 12.9898 + salt * 78.233) * 43758.5453;

  return value - Math.floor(value);
};

const generatedMenuSprinkles = Array.from({ length: 4000 }, (_, index) => {
  const bandSeed = seededNoise(index, 1);
  const band = bandSeed < 0.34 ? 0 : bandSeed < 0.68 ? 1 : 2;
  const x =
    band === 0
      ? 1.5 + seededNoise(index, 2) * 22
      : band === 1
        ? 76 + seededNoise(index, 3) * 22
        : 24 + seededNoise(index, 6) * 52;
  const y = 2 + seededNoise(index, 4) * 94;
  const type = sprinkleTypes[index % sprinkleTypes.length];
  const tone = sprinkleTones[(index + band) % sprinkleTones.length];
  const s = 0.42 + seededNoise(index, 5) * 0.5;
  const r = -32 + ((index * 17) % 65);

  return [type, Number(x.toFixed(1)), Number(y.toFixed(1)), Number(s.toFixed(2)), r, tone];
});

const menuSprinkles = [...handPlacedMenuSprinkles, ...generatedMenuSprinkles]
  .reduce((selectedSprinkles, sprinkle) => {
    if (
      selectedSprinkles.length < 120 &&
      isAwayFromMainDoodles(sprinkle) &&
      isAwayFromOtherSprinkles(sprinkle, selectedSprinkles)
    ) {
      selectedSprinkles.push(sprinkle);
    }

    return selectedSprinkles;
  }, [])
  .map(([type, x, y, s, r, tone]) => ({
    type,
    x,
    y,
    s,
    r,
    tone,
  }));
